# ── Stage 1: Build Vite + TypeScript
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

# ── Stage 2: Serve con Nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Escribir nginx.conf directamente (evita problemas de contexto)
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
        add_header Cache-Control "no-cache";\n\
    }\n\
\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass         http://backend:5000/;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header   Host $host;\n\
        proxy_set_header   X-Real-IP $remote_addr;\n\
        proxy_read_timeout 120s;\n\
        add_header Access-Control-Allow-Origin  * always;\n\
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;\n\
        add_header Access-Control-Allow-Headers "Content-Type" always;\n\
        if ($request_method = OPTIONS) { return 204; }\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/html text/css application/javascript application/json;\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
