{
  "name": "sythrall",
  "version": "5.2.0",
  "description": "Sythrall — plataforma de inteligencia de código: análisis estático multi-lenguaje, inspección ML/DL, grafos de código y terminal integrada. Motor en Rust.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Brashkie",
    "url": "https://github.com/Brashkie"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brashkie/Sythrall.git"
  },
  "bugs": {
    "url": "https://github.com/Brashkie/Sythrall/issues"
  },
  "homepage": "https://github.com/Brashkie/Sythrall#readme",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-banner.mjs && concurrently -n web,term,cx -c blue,magenta,cyan \"npm:dev:web\" \"npm:dev:term\" \"npm:dev:cx\"",
    "dev:web": "vite",
    "dev:term": "node scripts/run-terminal.mjs",
    "dev:cx": "node scripts/run-complexity.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansimax": "^1.5.0",
    "diff": "^5.2.0",
    "jszip": "^3.10.1",
    "mermaid": "^11.4.0",
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "concurrently": "10.0.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
