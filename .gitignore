# ================================
# SYTHRALL — .gitignore v4.2
# ================================

# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────
dist/
.vite/
/target/

# ── Environment files — NEVER commit ─────────────────────
.env
*.env.local
*.env.production
*.env.development

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── VS Code ──────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
# .vscode/extensions.json  ← déjalo si quieres compartir extensiones recomendadas

# ── Herramientas de IA (estado local, nunca se sube) ─────
.claude/
.cursor/

# ── Python / Backend ─────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
.Python
*.egg-info/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# pytest / ruff (los cachés generan su propio .gitignore interno, pero se
# declaran también acá de forma explícita para no depender de eso)
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Cython compiled files
*.so
*.pyd
*.c
*.cpp
# Except tracked source files — override below if needed
!apps/api/services/*.c
!apps/api/services/*.cpp

# mypy / pyright
.mypy_cache/
.pyright/

# ── Uploads / Project data ───────────────────────────────
# Proyectos subidos por usuarios — no subir al repo
# (genérico: el backend crea uploads/ relativo a su cwd, que normalmente es
# apps/api/, pero cualquier invocación con otro cwd también debe quedar afuera)
uploads/

# ── Docker ───────────────────────────────────────────────
# Los volúmenes locales de Docker no se suben
.docker/

# ── TypeScript / Vite ────────────────────────────────────
*.tsbuildinfo
apps/web/src/**/*.js.map

# ── Misc ─────────────────────────────────────────────────
*.zip
*.tar.gz
*.bak
*.swp
*.tmp