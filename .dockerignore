# Keeps the build context small — all 4 Dockerfiles (docker/*.Dockerfile)
# share the repo root as their build context (`context: ..` in
# docker/docker-compose.yml). This file MUST stay at the repo root, not in
# docker/: Docker only reads .dockerignore from the build context directory,
# never from the Dockerfile's own directory.

node_modules
dist
.vite
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
apps/api/uploads
.git
.github
scripts
*.md
.vscode
